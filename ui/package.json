{
  "name": "pb-explorer",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "cabal run --project-dir ../parser pb-runner -v0 -- --emit-ts > src/types/ast.generated.ts",
    "build": "vite build",
    "codegen": "cabal run --project-dir ../parser pb-runner -v0 -- --emit-ts > src/types/ast.generated.ts",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.0",
    "highlight.js": "^11.11.1",
    "solid-js": "^1.9.0",
    "valtio": "^2.3.2"
  },
  "devDependencies": {
    "babel-preset-solid": "^1.9.0",
    "happy-dom": "^20.10.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.10",
    "vitest": "^4.1.8"
  }
}
