{
  "name": "pb-explorer",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "cabal run --project-dir ../parser pb-runner -v0 -- --emit-ts > src/types/ast.generated.ts && cabal run --project-dir ../parser pb-runner -v0 -- --emit-py > ../cli/pb_cli/core/ast_generated.py",
    "build": "vite build",
    "codegen": "cabal run --project-dir ../parser pb-runner -v0 -- --emit-ts > src/types/ast.generated.ts && cabal run --project-dir ../parser pb-runner -v0 -- --emit-py > ../cli/pb_cli/core/ast_generated.py",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "bombadil": "bombadil browser test http://localhost:8000 bombadil-spec.ts --headless --exit-on-violation --time-limit 5m --output-path /tmp/bombadil-pb",
    "bombadil:long": "bombadil browser test http://localhost:8000 bombadil-spec.ts --headless --time-limit 5m --output-path /tmp/bombadil-pb",
    "bombadil:headed": "bombadil browser test http://localhost:8000 bombadil-spec.ts --exit-on-violation --time-limit 5m --output-path /tmp/bombadil-pb"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.0",
    "highlight.js": "^11.11.1",
    "solid-js": "^1.9.0",
    "valtio": "^2.3.2"
  },
  "devDependencies": {
    "@antithesishq/bombadil": "^0.6.0",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "babel-preset-solid": "^1.9.0",
    "eslint": "^10.5.0",
    "fast-check": "^4.8.0",
    "happy-dom": "^20.10.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.10",
    "vitest": "^4.1.8"
  }
}
