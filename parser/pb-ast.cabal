cabal-version:      3.4
name:               pb-ast
version:            0.1.0.0
license:            BSD-3-Clause
license-file:       LICENSE
author:             Thomas Marsh
maintainer:         thomas.marsh2@gmail.com
category:           Language
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common common-settings
  default-language: GHC2024
  default-extensions:
    NoImplicitPrelude
    OverloadedStrings
    DuplicateRecordFields
  ghc-options:
    -Wall
    -Wcompat
    -Wincomplete-patterns
    -O2

library
  import: common-settings
  hs-source-dirs: src
  exposed-modules:
    PB.Prelude
    PB.AST.BodyStmt
    PB.AST.DataWindow
    PB.AST.Expr
    PB.AST.Located
    PB.AST.SourceFile
    PB.AST.Type
    PB.Grammar.Body
    PB.Grammar.DataWindow
    PB.Grammar.File
    PB.Grammar.Stream
    PB.Lexing.DataWindow
    PB.Lexing.Escape
    PB.Lexing.Lexer
    PB.Lexing.Splitter
    PB.Lexing.Token
    PB.Pipeline.CfgBuild
    PB.Pipeline.CpsCompile
    PB.Pipeline.DeadCode
    PB.Pipeline.Dataflow
    PB.Pipeline.PbApi
    PB.Pipeline.Taint
    PB.Pipeline.Preprocess
    PB.Pipeline.Runner
    PB.Pipeline.Serialise
    PB.Pipeline.Church
    PB.Pipeline.TypeEnv
    PB.Pipeline.TypeResolve
    PB.Pipeline.SqlParse
    PB.Pipeline.Walk
  build-depends:
    , base ^>=4.20.1.0
    , text
    , megaparsec
    , aeson >=2.0
    , aeson-typescript >=0.6
    , template-haskell >=2.21
    , bytestring  ^>=0.12
    , containers >=0.6
    , directory  ^>=1.3
    , file-embed ^>=0.0.16
    , filepath   >=1.4
    , mtl >=2.2
    , unordered-containers >=0.2
    , async >= 2.2
    , ghc-compact
    , time >= 1.9
    , process >= 1.6
    , vector >= 0.12

executable pb-runner
  import: common-settings
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options: -rtsopts -threaded
  build-depends:
    , base ^>=4.20.1.0
    , pb-ast
    , text
    , aeson
    , bytestring   ^>=0.12
    , directory    ^>=1.3
    , filepath     >=1.4
    , optparse-applicative ^>=0.18

test-suite pb-ast-test
  import: common-settings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
      ChurchTest
    , BodyParserTest
    , BodyStmtTest
    , CfgBuildTest
    , CorpusDebtTest
    , CpsCompileTest
    , DataflowTest
    , DeadCodeTest
    , TaintTest
    , DataWindowTest
    , CorpusInvariantTest
    , CorpusTest
    , EscapeTest
    , ExprTest
    , FileTest
    , PbApiTest
    , PipelineTest
    , RunnerTest
    , SerialiseTest
    , SplitterTest
    , SqlParseTest
    , StreamTest
    , TokenTest
    , TypeEnvTest
    , TypeResolveTest
  build-depends:
    , base ^>=4.20.1.0
    , pb-ast
    , text
    , tasty
    , tasty-hunit
    , tasty-hedgehog
    , hedgehog       >=1.4
    , megaparsec
    , aeson
    , bytestring  ^>=0.12
    , containers   >=0.6
    , directory    ^>=1.3
    , filepath     >=1.4
    , mtl >=2.2
    , process >= 1.6
    , vector >= 0.12
