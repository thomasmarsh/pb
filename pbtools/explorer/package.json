{
  "name": "pb-explorer",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "cabal run --project-dir ../.. pb-runner -v0 -- --emit-ts > src/types/ast.generated.ts",
    "build": "vite build",
    "codegen": "cabal run --project-dir ../.. pb-runner -v0 -- --emit-ts > src/types/ast.generated.ts",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.0",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "babel-preset-solid": "^1.9.0",
    "happy-dom": "^18.0",
"typescript": "^5.7",
    "vite": "^6.0",
    "vite-plugin-solid": "^2.10",
    "vitest": "^3.2"
  }
}
