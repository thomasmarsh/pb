HA$PBExportHeader$fn_perm.srf
$PBExportComments$
global type fn_perm from function_object
end type

forward prototypes
global function boolean fn_perm (string as_action, string as_perm)
end prototypes

global function boolean fn_perm (string as_action, string as_perm);// Ελέγχει αν ο τρέχον χρήστης έχει δικαιώματα πρόσβασης 
// στην εργασία as_tag και στην ενέργεια as_action
// as_action can be: addrec, editrec, delrec, openlist, openform
 

integer 	li_perm
string	ls_message 


// Ο έλεγχος δικαιωμάτων γίνεται μόνο αν gb_useperm = true
// Ο Διαχειριστής (koduser = -1) έχει όλα τα δικαιώματα
	if not gb_useperm or gl_koduser = -1 then return true
	
// Αν το as_action είναι κενό επιστρέφουμε true
	if as_action = "" or isnull(as_action) then return true
	
choose case as_perm 
		
	case "addrec"
		
		select sum(addrec) into :li_perm
		from   usrgroupperm, usrmembers
		where  usrgroupperm.kodgroup = usrmembers.kodgroup
		and	 usrmembers.koduser = :gl_koduser
		and	 usrgroupperm.kodaction = :as_action;
		fn_sqlerror()
		
		ls_message = trn(197)
		
	case "editrec"
		
		select sum(editrec) into :li_perm
		from   usrgroupperm, usrmembers
		where  usrgroupperm.kodgroup = usrmembers.kodgroup
		and	 usrmembers.koduser = :gl_koduser
		and	 usrgroupperm.kodaction = :as_action;
		fn_sqlerror()
		
		ls_message = ""
		
	case "delrec"
		
		select sum(delrec) into :li_perm
		from   usrgroupperm, usrmembers
		where  usrgroupperm.kodgroup = usrmembers.kodgroup
		and	 usrmembers.koduser = :gl_koduser
		and	 usrgroupperm.kodaction = :as_action;
		fn_sqlerror()
		
		ls_message = trn(196)
		
	case "openlist"
		
		select sum(openlist) into :li_perm
		from   usrgroupperm, usrmembers
		where  usrgroupperm.kodgroup = usrmembers.kodgroup
		and	 usrmembers.koduser = :gl_koduser
		and	 usrgroupperm.kodaction = :as_action;
		fn_sqlerror()

		ls_message = trn(355)
		
	case "openform"
		
		select sum(openform) into :li_perm
		from   usrgroupperm, usrmembers
		where  usrgroupperm.kodgroup = usrmembers.kodgroup
		and	 usrmembers.koduser = :gl_koduser
		and	 usrgroupperm.kodaction = :as_action;
		fn_sqlerror()

		ls_message = trn(355)
		
end choose


// Επιστροφή
	if li_perm >= 1 then 
		return true
	else
		if ls_message <> "" then 	MessageBox(gs_app_name, ls_message)
		return false
	end if
end function

