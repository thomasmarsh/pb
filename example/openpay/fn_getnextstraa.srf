global type fn_getnextstraa from function_object
end type

forward prototypes
global function string fn_getnextstraa (string as_aa, integer ai_digits)
end prototypes

global function string fn_getnextstraa (string as_aa, integer ai_digits);// Επιστρέφει τον επόμενο από τον as_aa αριθμό σε μορφή string
// Η μορφή είναι 001, 010, 011, .... ανάλογα με το ai_digits

// Αν το as_aa είναι null ή "" το κάνουμε 0
	if isnull(as_aa) or as_aa = "" then as_aa = "0"

// Μετατροπή σε number και αύξηση κατά 1
	long		ll_nextaa
	ll_nextaa = long(as_aa) + 1
	
// Μετατροπή ξανά σε string και βρίσκουμε τον νέο αριθμό ψηφίων
	string	ls_nextaa
	integer	li_nextdigits
	
	ls_nextaa = string(ll_nextaa)
	li_nextdigits = len(ls_nextaa)
	
// Τα ψηφία που περισεύουν προς τα αριστερά τα κάνουμε 0
	integer	li_zeros, i
	li_zeros = ai_digits - li_nextdigits
	for i = 1 to li_zeros
		ls_nextaa = "0" + ls_nextaa
	next
	
// Επιστροφή
	return ls_nextaa
end function

