$PBExportComments$
global type fn_createds_zpkrat from function_object
end type

forward prototypes
global function datastore fn_createds_zpkrat (ref datawindow adw)
end prototypes

global function datastore fn_createds_zpkrat (ref datawindow adw);// Δημιουργία datastore με τις κρατήσεις
// που ήδη έχουμε καταχωρήσει στο adw πριν την τρέχουσα γραμμή

// Παίρνουμε την τρέχουσα εγγραφή
	long	ll_row
	ll_row = adw.getrow()

// Δημιουργία datastore του τύπου edw_var
	datastore		lds_krat
	lds_krat = fn_createds("edw_var")
	
// Μεταφορά από dw για όλες τις γραμμές που προηγούνται
	string	ls_kodkrat, ls_desckrat
	long		i, ll_newrow
	
	for i = 1 to ll_row - 1
		
		ll_newrow = lds_krat.insertrow(0)
		
		ls_kodkrat = adw.object.kodkrat[i]
				
		select desckrat into :ls_desckrat
		from   misth_zpkrat
		where  kodkrat = :ls_kodkrat and kodxrisi = :gs_kodxrisi;
		fn_sqlerror()
		
		lds_krat.object.kodvar[ll_newrow] = ls_kodkrat
		lds_krat.object.descvar[ll_newrow] = ls_desckrat
		
	next
	
// Επιστροφή
	return lds_krat
end function

