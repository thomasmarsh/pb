global type fn_toupper from function_object
end type

forward prototypes
global function string fn_toupper (string astr)
end prototypes

global function string fn_toupper (string astr);// Μετατροπή σε κεφαλαία
// Η upper() συνάρτηση του powerbuilder διατηρεί τους τόνους
// Μετατροπή πρώτα σε πεζά για να ρυθμιστούν τα διαλυτικά

string	ls_tolower

ls_tolower = lower(astr)

// Αλλαγή τονούμενων κεφαλαίων με άτονα
ls_tolower = fn_replace_str(ls_tolower, "ά", "α")
ls_tolower = fn_replace_str(ls_tolower, "έ", "ε")
ls_tolower = fn_replace_str(ls_tolower, "ό", "ο")
ls_tolower = fn_replace_str(ls_tolower, "ή", "η")
ls_tolower = fn_replace_str(ls_tolower, "ί", "ι")
ls_tolower = fn_replace_str(ls_tolower, "ϊ", "ι")
ls_tolower = fn_replace_str(ls_tolower, "ΐ", "ι")
ls_tolower = fn_replace_str(ls_tolower, "ύ", "υ")
ls_tolower = fn_replace_str(ls_tolower, "ϋ", "υ")
ls_tolower = fn_replace_str(ls_tolower, "ΰ", "υ")
ls_tolower = fn_replace_str(ls_tolower, "ώ", "ω")

// Επιστροφή κεφαλαίων
	return upper(ls_tolower)




end function

