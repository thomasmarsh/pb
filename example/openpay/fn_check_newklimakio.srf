$PBExportComments$
global type fn_check_newklimakio from function_object
end type

forward prototypes
global subroutine fn_check_newklimakio ()
end prototypes

global subroutine fn_check_newklimakio ();// Έλεγχος για αλλαγή κλιμακίου εργαζομένων

// Μετράμε τους εργαζομένους που πρέπει να αλλάξουν κλιμάκιο
	long	ll_count
	date	ldt_today
	
	ldt_today = today()
	

	select 
		count(kodypal) 
	into
		:ll_count
	from	
		misth_ypal
	where
		kodxrisi = :gs_kodxrisi
	and
		exeldate <= :ldt_today;

	fn_sqlerror()
	
// Αν δεν υπάρχουν εργαζόμενοι για αλλάγη, επιστροφή
// Αν υπάρχουν προβολή
	if isnull(ll_count) or ll_count = 0 then
		return
	else
		open(w_misth_ypal_newklimakio)
	end if
end subroutine

