cabal-version:      3.4
name:               pb-compiler
version:            0.1.0.0
license:            BSD-3-Clause
license-file:       LICENSE
author:             Thomas Marsh
maintainer:         thomas.marsh2@gmail.com
category:           Language
build-type:         Simple
extra-doc-files:    CHANGELOG.md
extra-source-files: ../runtime/*.sru

common common-settings
  default-language: GHC2024
  default-extensions:
    NoImplicitPrelude
    OverloadedStrings
    DuplicateRecordFields
  ghc-options:
    -Wall
    -Wcompat
    -Wincomplete-patterns
    -Werror
    -O2

library
  import: common-settings
  hs-source-dirs: src
  exposed-modules:
    PB.Prelude
    PB.AST.BodyStmt
    PB.AST.DataWindow
    PB.AST.DwPropertySchema
    PB.AST.Expr
    PB.AST.Ident
    PB.AST.Located
    PB.AST.SourceFile
    PB.AST.Type
    PB.Grammar.Body
    PB.Grammar.DataWindow
    PB.Grammar.File
    PB.Grammar.Stream
    PB.Grammar.Unparse
    PB.Lexing.DataWindow
    PB.Lexing.Escape
    PB.Lexing.Lexer
    PB.Lexing.Splitter
    PB.Lexing.Token
    PB.Analysis.Builtins
    PB.Analysis.DwBuiltins
    PB.Analysis.CallClassify
    PB.Analysis.Cfg
    PB.Analysis.CloneDetect
    PB.Compile.IR
    PB.Compile.SSA
    PB.Compile.LoopAnalysis
    PB.Compile.FromSSA
    PB.Compile.Flatten
    PB.Compile.Interp
    PB.Compile.InstrTypes
    PB.Compile.InstrInterp
    PB.Compile.ValueModel
    PB.Analysis.Dataflow
    PB.Analysis.DeadVars
    PB.Analysis.InterpCoverage
    PB.Analysis.SchemaCategory
    PB.Analysis.SchFootprint
    PB.Analysis.DwFootprint
    PB.Analysis.DwBindingFootprint
    PB.Analysis.Taint
    PB.Analysis.TypeEnv
    PB.Analysis.TypeResolve
    PB.Analysis.TypeFamily
    PB.Analysis.TypeCheck
    PB.Analysis.ControlHierarchy
    PB.Analysis.DwParamBinding
    PB.Pipeline.Preprocess
    PB.Pipeline.Emit
    PB.Pipeline.Passes
    PB.Pipeline.Progress
    PB.Pipeline.Runner
    PB.Pipeline.Serialise
    PB.Pipeline.DuckDb
    PB.Pipeline.DuckDb.Appender
    PB.Pipeline.DuckDb.PhaseA
    PB.Pipeline.DuckDb.PhaseB.Query
    PB.Pipeline.DuckDb.PhaseB.Append
    PB.Pipeline.DuckDb.Materialize
    PB.Pipeline.DuckDb.Relations
    PB.Pipeline.SqlParse
    PB.Pipeline.FileWalk
    PB.Runtime.StdLib
    PB.Algebra.Semiring
    PB.Algebra.Closure
    PB.Analysis.TaintEdges
    PB.Analysis.TaintClosure
    PB.Analysis.DeadCodeReachability
    PB.Analysis.SchemaClosure
  build-depends:
    , base ^>=4.20.1.0
    , text
    , megaparsec
    , aeson >=2.0
    , bytestring  ^>=0.12
    , containers >=0.6
    , directory  ^>=1.3
    , file-embed ^>=0.0.16
    , filepath   >=1.4
    , mtl >=2.2
    , unordered-containers >=0.2
    , hashable >=1.3
    , async >= 2.2
    , ghc-compact
    , time >= 1.9
    , process >= 1.6
    , vector >= 0.12
    , duckdb-simple >= 0.1.5.1 && < 0.2
    , duckdb-ffi    >= 1.5.0.0 && < 1.6
    , stm           >= 2.5
    , template-haskell
    , temporary     >= 1.3
    , deepseq
    , parallel      >= 3.2

executable pbc
  import: common-settings
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options: -rtsopts -threaded -with-rtsopts=-N
  build-depends:
    , base ^>=4.20.1.0
    , pb-compiler
    , text
    , aeson
    , bytestring   ^>=0.12
    , directory    ^>=1.3
    , filepath     >=1.4
    , optparse-applicative ^>=0.18

executable taint-corpus-bench
  import: common-settings
  hs-source-dirs: bench
  main-is: TaintCorpusBench.hs
  ghc-options: -rtsopts -threaded -with-rtsopts=-N
  build-depends:
    , base ^>=4.20.1.0
    , pb-compiler
    , text
    , containers >=0.6
    , unordered-containers >=0.2
    , time >= 1.9
    , optparse-applicative ^>=0.18

executable deadcode-corpus-bench
  import: common-settings
  hs-source-dirs: bench
  main-is: DeadCodeCorpusBench.hs
  ghc-options: -rtsopts -threaded -with-rtsopts=-N
  build-depends:
    , base ^>=4.20.1.0
    , pb-compiler
    , text
    , containers >=0.6
    , unordered-containers >=0.2
    , time >= 1.9
    , optparse-applicative ^>=0.18
    , duckdb-simple >= 0.1.5.1 && < 0.2

executable schema-corpus-bench
  import: common-settings
  hs-source-dirs: bench
  main-is: SchemaCorpusBench.hs
  ghc-options: -rtsopts -threaded -with-rtsopts=-N
  build-depends:
    , base ^>=4.20.1.0
    , pb-compiler
    , text
    , containers >=0.6
    , unordered-containers >=0.2
    , time >= 1.9
    , optparse-applicative ^>=0.18
    , duckdb-simple >= 0.1.5.1 && < 0.2

test-suite pb-compiler-test
  import: common-settings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
      RepoRoot
    , PhaseATest
    , PhaseBQueryTest
    , PhaseBAppendTest
    , MaterializeTest
    , SmallCheckInstances
    , RelationsTest
    , DeadCodeFixtures
    , StdLibTest
    , BodyParserTest
    , BodyStmtTest
    , CfgTest
    , CorpusDebtTest
    , CatEvalTest
    , EffTermTest
    , GoldenFixtureTest
    , SSATest
    , DataflowTest
    , DeadCodeTest
    , DeadVarsTest
    , InterpCoverageTest
    , TaintTest
    , DataWindowTest
    , CorpusInvariantTest
    , CorpusTest
    , EscapeTest
    , ExprTest
    , FileTest
    , IdentTest
    , PbApiTest
    , PipelineTest
    , ProgressTest
    , RunnerTest
    , SchemaCategoryTest
    , SchFootprintTest
    , DwFootprintTest
    , DwBindingFootprintTest
    , SerialiseTest
    , SplitterTest
    , SqlParseTest
    , StreamTest
    , TokenTest
    , TypeEnvTest
    , TypeResolveTest
    , TypeFamilyTest
    , TypeCheckTest
    , ControlHierarchyTest
    , DwParamBindingTest
    , DwBuiltinsTest
    , CallClassifyTest
    , CloneDetectTest
    , ClosureTest
    , TaintEdgesTest
    , TaintClosureTest
    , DeadCodeReachabilityTest
    , SchemaClosureTest
  build-depends:
    , base ^>=4.20.1.0
    , pb-compiler
    , text
    , tasty
    , tasty-hunit
    , tasty-hedgehog
    , tasty-smallcheck ==0.8.2
    , smallcheck       ==1.2.1.1
    , hedgehog       >=1.4
    , megaparsec
    , aeson
    , bytestring  ^>=0.12
    , containers   >=0.6
    , directory    ^>=1.3
    , filepath     >=1.4
    , mtl >=2.2
    , process >= 1.6
    , vector >= 0.12
    , duckdb-simple >= 0.1.5.1 && < 0.2
    , deepseq
